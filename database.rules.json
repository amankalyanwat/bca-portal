{
  "rules": {
    "worldPresence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['x', 'y', 'z', 'name', 'updatedAt']) && newData.child('name').isString() && newData.child('updatedAt').isNumber()"
      }
    }
  }
}
